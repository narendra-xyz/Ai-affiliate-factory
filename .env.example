# ==== SERVER ====
PORT=4000
NODE_ENV=production
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=12h

# ==== ADMIN LOGIN (dashboard auth) ====
ADMIN_USERNAME=admin
# Generate with: node -e "console.log(require('bcryptjs').hashSync('yourpassword',10))"
ADMIN_PASSWORD_HASH=

# ==== 9ROUTER (AI GATEWAY) ====
NINEROUTER_API_KEY=your_9router_api_key_here
NINEROUTER_BASE_URL=https://api.9router.com/v1

# Per-agent model pool. Format: "model_id[:tier][:daily_limit], ..."
# tier defaults to 'free'. Leave an agent's var unset and the system will
# clearly report that agent as "Not Configured" instead of guessing.
# Fill these with REAL model IDs available on your 9Router account.
NINEROUTER_MODELS_PRODUCT_HUNTER=
NINEROUTER_MODELS_TREND_HUNTER=
NINEROUTER_MODELS_SCRIPT_WRITER=
NINEROUTER_MODELS_CONTENT_AGENT=
NINEROUTER_MODELS_CRITIC_AGENT=
NINEROUTER_MODELS_MONEY_AGENT=
NINEROUTER_MODELS_COMMAND_CENTER=
# How long (minutes) a model stays marked "limited" after a rate-limit/quota
# error before the router will try it again.
MODEL_COOLDOWN_MINUTES=30

# ==== N8N ====
N8N_BASE_URL=http://localhost:5678
N8N_WEBHOOK_TOKEN=change_this_shared_secret

# ==== PRODUCT DATA PROVIDER ====
# Real product data source. If unset, Product Hunter reports
# "not_configured" and will NOT fabricate product data.
# Expected response shape: { products: [{ name, price, url, affiliate_url,
# rating, review_count, commission_rate, category, image_url }, ...] }
PRODUCT_DATA_PROVIDER_URL=
PRODUCT_DATA_PROVIDER_KEY=

# ==== TREND/RESEARCH PROVIDER ====
# Optional real-time trend data source. If unset, Trend Hunter still runs
# (AI brainstorming) but tags output as 'ai_generated_heuristic' rather
# than claiming real-time trend awareness.
TREND_DATA_PROVIDER_URL=
TREND_DATA_PROVIDER_KEY=

# ==== AFFILIATE LINK PROVIDER ====
# Name is just a label shown in the dashboard. The generator URL (if you
# have one) turns a product_url into a real tracked affiliate link.
AFFILIATE_PROVIDER_NAME=
AFFILIATE_PROVIDER_KEY=
AFFILIATE_LINK_GENERATOR_URL=

# ==== TEXT-TO-SPEECH ====
# 'local_espeak' (default): free, offline, no credentials - requires
# espeak-ng installed on the VPS: apt-get install espeak-ng
# 'external': uses TTS_API_URL + TTS_API_KEY for a higher-quality voice.
TTS_PROVIDER=local_espeak
TTS_LANG=id
TTS_API_URL=
TTS_API_KEY=
TTS_VOICE=

# ==== VISUAL / STOCK MEDIA PROVIDER ====
# Optional. If unset, Content Agent falls back to a real FFmpeg-generated
# text card (no external dependency), or the product's own image_url if
# Product Hunter's data included one.
VISUAL_MEDIA_PROVIDER_URL=
VISUAL_MEDIA_PROVIDER_KEY=

# ==== PUBLISHING PROVIDER ====
# Name is just a label shown in the dashboard - actual per-platform
# publish integration (TikTok/YouTube/etc) is not included in this MVP;
# videos reaching ready_to_publish must be published manually until wired in.
PUBLISHING_PROVIDER_NAME=

# ==== VIDEO RENDER ====
RENDER_TIMEOUT_MS=180000

# ==== STORAGE ====
# Local permanent storage for finished renders (always active).
LOCAL_VIDEO_STORAGE_DIR=./backend/storage/videos
# Retention policy so local disk on the VPS never grows unbounded. Oldest
# videos are purged first (metadata kept in DB, only the file is removed)
# once either limit is hit.
LOCAL_STORAGE_MAX_GB=20
LOCAL_STORAGE_MAX_DAYS=30
# Optional S3-compatible object storage. NOTE: upload code is currently a
# stub (see storage.adapter.js) - setting these does NOT yet enable real
# object storage uploads; check /api/system/integrations for true status.
STORAGE_PROVIDER=
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# ==== DATABASE ====
DATABASE_PATH=./backend/db/affiliate_factory.sqlite

# ==== COST DEFAULTS (IDR) ====
DEFAULT_SERVER_COST_MONTHLY=72000

# ==== RESOURCE LIMITS ====
MAX_VIDEO_CONCURRENCY=2
MAX_AGENT_CONCURRENCY=3
RAM_SOFT_LIMIT_MB=4096
RAM_HARD_LIMIT_MB=6144

# ==== TIKTOK INTEGRATION ====
# Register an app at https://developers.tiktok.com/ to get these. Login
# Kit scope + Content Posting API access must be requested/approved
# there; publish to public audiences requires TikTok's app audit.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must exactly match the redirect URI registered in your TikTok app,
# pointing at this backend's OAuth callback route.
TIKTOK_REDIRECT_URI=https://your-domain.example.com/api/tiktok/auth/callback
# Space or comma separated scopes requested during OAuth. Only scopes
# your app has been approved for will actually be granted by TikTok.
TIKTOK_OAUTH_SCOPES=user.info.basic,video.publish,video.list
# 32-byte hex key used to encrypt stored access/refresh tokens at rest.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TIKTOK_TOKEN_ENCRYPTION_KEY=
# How long to wait for TikTok's publish status to reach a terminal state
# before giving up (does not cancel the actual TikTok-side processing).
TIKTOK_PUBLISH_TIMEOUT_MS=180000
TIKTOK_API_TIMEOUT_MS=20000
# How often (ms) the backend automatically pulls fresh view/like/comment/
# share stats for published TikTok videos into performance_metrics.
TIKTOK_PERFORMANCE_SYNC_INTERVAL_MS=1800000
# Separate low concurrency for the TikTok publish queue (keep at 1-2 to
# respect TikTok's own rate limits).
MAX_TIKTOK_CONCURRENCY=1

# ==== TIKTOK SHOP INTEGRATION (Shoppable Video) ====
# Register an app in TikTok Shop Partner Center (https://partner.tiktokshop.com/),
# separate from the regular TikTok Developer app above - different
# credentials, different API surface (open-api.tiktokglobalshop.com),
# and requires request signing (see tiktokShopClient.js).
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
# Must exactly match the redirect URI registered in TikTok Shop Partner
# Center, pointing at this backend's Shop OAuth callback route.
TIKTOK_SHOP_REDIRECT_URI=https://your-domain.example.com/api/tiktok-shop/auth/callback
# Override only if your Shop Partner Center app uses a different auth
# host/service id than the defaults.
TIKTOK_SHOP_AUTHORIZE_URL=https://services.tiktokshop.com/open/authorize
TIKTOK_SHOP_SERVICE_ID=
TIKTOK_SHOP_API_BASE=https://open-api.tiktokglobalshop.com
TIKTOK_SHOP_API_TIMEOUT_MS=20000
TIKTOK_SHOP_PUBLISH_TIMEOUT_MS=180000
# Shared secret TikTok Shop's product-link-status webhook must send back
# to this backend (header: x-tiktok-shop-webhook-token). Generate with:
# node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TIKTOK_SHOP_WEBHOOK_SECRET=
# Separate low concurrency for the shoppable video publish queue.
MAX_TIKTOK_SHOP_CONCURRENCY=1
# Reuses the same AES key as the regular TikTok integration
# (TIKTOK_TOKEN_ENCRYPTION_KEY above) - no separate key needed.
